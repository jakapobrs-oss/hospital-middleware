# Copy to .env before starting the stack:  cp .env.example .env
# .env is git-ignored. Every value below is a placeholder for local use; change the secrets for any real deployment.
# docker-compose.yml fixes the settings that are not meant to change (APP_PORT, GIN_MODE, MOCK_HIS_PORT).

# --- PostgreSQL ---
POSTGRES_USER=hospital
# Keep it URL-safe (letters and digits): it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me-use-letters-and-digits-only

# --- API ---
# Signs the access tokens. Must be at least 32 characters; generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-characters
# How long an access token stays valid (Go duration: 30m, 1h, ...).
JWT_TTL=1h

# Where each hospital's HIS lives: hospital-code=base-url, comma separated.
# The default points hospital-a at the mock HIS container.
HIS_BASE_URLS=hospital-a=http://mock-his:8081
# How long to wait for a HIS before answering from the local copy.
HIS_TIMEOUT=3s

# Apply the SQL migrations on start-up.
RUN_MIGRATIONS=true
# Load synthetic demo patients for both hospitals (never real data).
SEED_DEMO_DATA=true

# debug | info | warn | error
LOG_LEVEL=info

# Optional protection for POST /staff/create. Empty (the default) leaves registration open, as the assignment
# describes. When set, every registration request must send the same value in the X-Registration-Key header
# and gets 403 otherwise. Use a long random value, for example the output of:  openssl rand -hex 16
STAFF_REGISTRATION_KEY=
